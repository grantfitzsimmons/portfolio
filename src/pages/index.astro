---
import PageLayout from '../layouts/BaseLayout.astro'
import Section from '../components/Section.astro'
import Card from '../components/Card.astro'
import ProjectCard from '../components/ProjectCard.astro'
import Label from '../components/Label.astro'
import SkillLayout from '../components/SkillLayout.astro'
import TravelMap from '../components/TravelMap.astro'

import { Image } from 'astro:assets'
import astro from '../assets/profile.png'
import idigbioLogo from '../assets/idigbio-logo.png'
import spnhcLogo from '../assets/spnhc-logo.png'
import tdwgLogo from '../assets/tdwg-logo.svg'

import { getAllPosts, sortMDByDate } from '@/utils'
import { projectCards } from '../data/projects'

// const languages = ['SQL', 'Python', 'JavaScript', 'React', 'Astro', 'HTML', 'CSS']
const technologies = ['Python', 'JavaScript', 'React', 'SQL', 'HTML/CSS', 'Git', 'GitHub', 'Docker', 'AWS (EC2, RDS, S3, CloudWatch, DynamoDB)', 'DigitalOcean', 'Cloudflare', 'MySQL', 'MariaDB', 'CI/CD Pipelines', 'Discourse', 'Asana', 'Power BI', 'Google Analytics']
const specialties = ['Biodiversity Informatics', 'Product Strategy', 'Roadmap Planning', 'Program Management', 'Data Management', 'Stakeholder Communication', 'International Partnerships', 'Team Leadership', 'Customer Success', 'Cloud Infrastructure', 'Technical Documentation', 'Data Migration and Integration', 'Geoscience Informatics', 'Business Administration']
// const others = ['lorem', 'ipsum', 'lorem', 'ipsum', 'lorem']

const MAX_POSTS = 6
const allPosts = await getAllPosts()
const allPostsByDate: typeof allPosts = sortMDByDate(allPosts).slice(0, MAX_POSTS)
---

<PageLayout meta={{ title: 'Home' }}>
	<div class='flex w-full flex-col gap-y-10'>
		<section class='flex flex-col items-center gap-y-7'>
			<Image
				src={astro}
				alt='profile photo'
				class='h-28 w-auto rounded-full bg-green-300 p-2'
				loading='eager'
			/>

			<div class='flex flex-col items-center gap-y-4'>
				<div class='text-center'>
					<h1 class='text-3xl font-bold'>Hi, I’m Grant.</h1>
					<p class='mt-2 text-base text-muted-foreground'>Assistant Director · Product Leader · Biodiversity Informatician</p>
				</div>
				<a
					href='mailto:me@grantfitzsimmons.com'
					class='flex flex-row items-center gap-x-3 rounded-3xl border border-input px-4 py-2 text-sm shadow-sm transition-all hover:shadow-md'
				>
					<p class='font-medium'>Send me a message!</p>
				</a>
				<div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
					<!-- <Label title='Specify Collections Consortium'>
						<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' class='h-5 w-5' slot='icon'
							><path
								fill='currentColor'
								d='M4.615 20q-.69 0-1.152-.462Q3 19.075 3 18.385v-9.77q0-.69.463-1.152Q3.925 7 4.615 7H9V5.615q0-.69.463-1.152Q9.925 4 10.615 4h2.77q.69 0 1.153.463q.462.462.462 1.152V7h4.385q.69 0 1.152.463q.463.462.463 1.152v9.77q0 .69-.462 1.152q-.463.463-1.153.463zm0-1h14.77q.23 0 .423-.192q.192-.193.192-.423v-9.77q0-.23-.192-.423Q19.615 8 19.385 8H4.615q-.23 0-.423.192Q4 8.385 4 8.615v9.77q0 .23.192.423q.193.192.423.192M10 7h4V5.615q0-.23-.192-.423Q13.615 5 13.385 5h-2.77q-.23 0-.423.192q-.192.193-.192.423zM4 19V8z'
							></path></svg
						>
					</Label> -->
					<Label title='Kansas, United States'>
						<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' class='h-5 w-5' slot='icon'
							><path
								fill='currentColor'
								d='M12.003 11.73q.668 0 1.14-.475q.472-.475.472-1.143t-.475-1.14q-.476-.472-1.143-.472t-1.14.476q-.472.475-.472 1.143t.475 1.14q.476.472 1.143.472M12 19.677q2.82-2.454 4.458-4.991q1.638-2.538 1.638-4.39q0-2.744-1.737-4.53T12 3.981q-2.621 0-4.359 1.785t-1.737 4.53q0 1.852 1.638 4.39q1.639 2.537 4.458 4.99m0 1.343q-3.525-3.117-5.31-5.814q-1.786-2.697-1.786-4.909q0-3.173 2.066-5.234Q9.037 3 12 3t5.03 2.062q2.066 2.061 2.066 5.234q0 2.212-1.785 4.909q-1.786 2.697-5.311 5.814m0-10.904'
							></path></svg
						>
					</Label>
					<Label
						title='See me on GitHub'
						as='a'
						href='https://github.com/grantfitzsimmons'
						target='_blank'
					>
						<svg
							xmlns='http://www.w3.org/2000/svg'
							viewBox='0 0 30 30'
							slot='icon'
							class='h-6 w-6 text-foreground/75'
							>
							<path fill='currentColor' d="M15,3C8.373,3,3,8.373,3,15c0,5.623,3.872,10.328,9.092,11.63C12.036,26.468,12,26.28,12,26.047v-2.051 c-0.487,0-1.303,0-1.508,0c-0.821,0-1.551-0.353-1.905-1.009c-0.393-0.729-0.461-1.844-1.435-2.526 c-0.289-0.227-0.069-0.486,0.264-0.451c0.615,0.174,1.125,0.596,1.605,1.222c0.478,0.627,0.703,0.769,1.596,0.769 c0.433,0,1.081-0.025,1.691-0.121c0.328-0.833,0.895-1.6,1.588-1.962c-3.996-0.411-5.903-2.399-5.903-5.098 c0-1.162,0.495-2.286,1.336-3.233C9.053,10.647,8.706,8.73,9.435,8c1.798,0,2.885,1.166,3.146,1.481C13.477,9.174,14.461,9,15.495,9 c1.036,0,2.024,0.174,2.922,0.483C18.675,9.17,19.763,8,21.565,8c0.732,0.731,0.381,2.656,0.102,3.594 c0.836,0.945,1.328,2.066,1.328,3.226c0,2.697-1.904,4.684-5.894,5.097C18.199,20.49,19,22.1,19,23.313v2.734 c0,0.104-0.023,0.179-0.035,0.268C23.641,24.676,27,20.236,27,15C27,8.373,21.627,3,15,3z"></path>
							</svg
						>
					</Label>
					<Label
						title='Connect on Linkedin'
						as='a'
						href='https://www.linkedin.com/in/grant-fitzsimmons-9b776b196'
						target='_blank'
					>
						<svg
							xmlns='http://www.w3.org/2000/svg'
							viewBox='0 0 16 16'
							slot='icon'
							class='h-5 w-5 text-foreground/75'
							><path
								fill='currentColor'
								d='M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248c-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586c.173-.431.568-.878 1.232-.878c.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252c-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z'
							></path></svg
						>
					</Label>
				</div>
			</div>
		</section>

		<Section title='About'>
			<div class='space-y-3 text-muted-foreground'>
				<p>
					I’m an assistant director and product leader with more than five years of experience advancing biodiversity informatics and natural-history collections technology. At the Specify Collections Consortium, I help lead strategy, operations, product development, and international partnerships for a collections management platform serving more than 500 member collections across 25 countries.
				</p>
				<p>
					I translate the needs of curators and researchers into product roadmaps, scalable support programs, and cross-institutional initiatives.
				</p>
				<p>
					In my free time, I like to travel around the world, explore the outdoors, collect vintage computer hardware, and experiment with new technologies. I’m currently pursuing an MBA at the University of Kansas School of Business, where I’m focusing on product management, strategy, and international business.
				</p>
			</div>
		</Section>
		{
			allPostsByDate.length > 0 && (
				<Section title='Blog Posts'>
					<div class='scroll-fade relative overflow-hidden' id='blog-scroll-fade' data-fade-left='false' data-fade-right='false'>
						<button
							type='button'
							class='scroll-chevron scroll-chevron-left'
							data-scroll-btn='prev'
							data-scroll-target='blog-posts'
							aria-label='Scroll blog posts left'
						>
							<svg viewBox='0 0 24 24' class='h-5 w-5' aria-hidden='true'>
								<path
									fill='none'
									stroke='currentColor'
									stroke-linecap='round'
									stroke-linejoin='round'
									stroke-width='2'
									d='m15 18l-6-6l6-6'
									></path>
							</svg>
						</button>
						<button
							type='button'
							class='scroll-chevron scroll-chevron-right'
							data-scroll-btn='next'
							data-scroll-target='blog-posts'
							aria-label='Scroll blog posts right'
						>
							<svg viewBox='0 0 24 24' class='h-5 w-5' aria-hidden='true'>
								<path
									fill='none'
									stroke='currentColor'
									stroke-linecap='round'
									stroke-linejoin='round'
									stroke-width='2'
									d='m9 6l6 6l-6 6'
									></path>
							</svg>
						</button>
						<ul
							class='scrollbar-hide m-0 grid list-none auto-cols-[280px] grid-flow-col grid-rows-2 items-stretch gap-3 overflow-x-auto p-0 pb-2 sm:auto-cols-[320px]'
							data-scroll='blog-posts'
						>
						{allPostsByDate.map((p, index) => {
							const cover = p.data.coverImage
							return (
									<li class='flex'>
									<a
										data-astro-prefetch
										href={`/blog/${p.slug}/`}
									class='flex h-full min-w-[280px] flex-col gap-y-3 overflow-hidden rounded-2xl border border-border bg-primary-foreground transition-all hover:border-foreground/25 hover:shadow-sm sm:min-w-[320px]'
									>
										{cover && (
											typeof cover.src === 'string' ? (
												<img
													src={cover.src}
													alt={cover.alt}
											class='h-48 w-full object-cover'
													loading={index === 0 ? 'eager' : 'lazy'}
													fetchpriority={index === 0 ? 'high' : 'auto'}
													decoding='async'
												/>
											) : (
												<Image
													src={cover.src}
													alt={cover.alt}
											class='h-48 w-full object-cover'
													loading={index === 0 ? 'eager' : 'lazy'}
													fetchpriority={index === 0 ? 'high' : 'auto'}
													sizes='(min-width: 640px) 320px, 280px'
												/>
											)
										)}
										<div class='flex flex-col gap-y-0.5 px-5 py-4'>
											<h3 class='text-lg font-medium'>{p.data.title}</h3>
											<p class='text-muted-foreground'>{p.data.description}</p>
										</div>
									</a>
								</li>
							)
						})}
						</ul>
					</div>
				</Section>
			)
		}

		<Section title='Professional Roles'>
			<Card
				heading='Assistant Director'
				subheading='Specify Collections Consortium, University of Kansas'
				date='March 2026 - Present'
				imagePath='/src/assets/scc2026.svg'
				altText='Specify Collections Consortium'
				imageClass='h-12 w-auto md:-left-16'
			>
			<ul class='ml-4 list-disc text-muted-foreground'>
				<li>
					<u>Strategic Leadership:</u> Partner with SCC Director Aimee Stewart to set consortium direction and ensure long-term sustainability for the Specify platform and member services.
				</li>
				<li>
					<u>Product & Platform Strategy:</u> Guide the product roadmap and prioritize improvements to meet the evolving needs of our global user community.
				</li>
				<li>
					<u>Operations & Support:</u> Oversee day-to-day operations and enhance support services to maintain high-quality assistance for member collections.
				</li>
				<li>
					<u>Partnerships & Collaboration:</u> Strengthen international collaborations and integrations with partners such as GBIF, iDigBio, CSIRO, and SwissCollNet to expand data mobilization.
				</li>
				<li>
					<u>Team & Program Management:</u> Recruit, mentor, and supervise staff; establish KPIs and processes to monitor program impact and operational effectiveness.
				</li>
				<li>
					<u>Community Advocacy:</u> Advocate for digitization, data management, and mobilization across the biodiversity and geoscience communities.
				</li>
			</ul>
			</Card>
			<details class='group'>
				<summary
					class='flex cursor-pointer list-none items-center justify-center gap-x-1.5 rounded-lg border border-border bg-primary-foreground px-3 py-2 text-sm font-medium transition-all hover:bg-input [&::-webkit-details-marker]:hidden'
				>
					<span class='group-open:hidden'>Show 5 more roles</span>
					<span class='hidden group-open:inline'>Show fewer roles</span>
					<svg
						viewBox='0 0 24 24'
						class='h-4 w-4 transition-transform group-open:rotate-180'
						aria-hidden='true'
					>
						<path fill='currentColor' d='m7 10l5 5l5-5z'></path>
					</svg>
				</summary>
				<div class='mt-3 flex flex-col gap-y-3'>
			<Card
				heading='Technical Product Manager'
				subheading='Specify Collections Consortium, University of Kansas'
				date='November 2025 - March 2026'
				imagePath='/src/assets/scc2026.svg'
				altText='Specify Collections Consortium'
				imageClass='h-12 w-auto md:-left-16'
			>
			<ul class='ml-4 list-disc text-muted-foreground'>
				<li>
					<u>Product Strategy & Roadmap:</u> Defined and executed the strategic product roadmap for the Specify platform, serving 450+ member collections across 25 countries. Translated complex user feedback from global research institutions into prioritized technical requirements, driving platform evolution for biological and geoscience collections.
				</li>
				<li>
					<u>Revenue & Pricing Strategy:</u> Co-led the restructuring of Consortium membership levels and pricing tiers to align with operational costs, global market demands, and institutional budgets. Conducted formal cost assessments and financial forecasting for support, development, and cloud infrastructure.
				</li>
				<li>
					<u>GeoSpecify Initiative Lead:</u> Served as KU lead for the GeoSpecify project, extending Specify for geoscience collections. Conducted stakeholder interviews with 30+ institutions, compiled default taxonomic trees for minerals, rocks, and meteorites, and presented findings at the European Mineralogical Conference in 2024.
				</li>
				<li>
					<u>International Partnerships:</u> Cultivated strategic relationships with collaborators including the Swiss Academy of Sciences (SwissCollNet), GBIF, iDigBio, CSIRO, and the Canadian Forest Service to orchestrate joint ventures, software integrations, and global data publishing pipelines.
				</li>
				<li>
					<u>Operational Management & KPIs:</u> Oversaw internal operations for support and documentation units. Established and monitored KPIs and metrics to evaluate operational effectiveness, service quality, and team performance.
				</li>
				<li>
					<u>Team Leadership:</u> Recruited, trained, and supervised student support staff. Directed daily workflows to ensure responsive technical assistance across six continents.
				</li>
			</ul>
			</Card>
			<Card
				heading='Product and Technical Support Manager'
				subheading='Specify Collections Consortium, University of Kansas'
				date='May 2023 - November 2025'
				imagePath='/src/assets/scc2026.svg'
				altText='Specify Collections Consortium'
				imageClass='h-12 w-auto md:-left-16'
			>
			<ul class='ml-4 list-disc text-muted-foreground'>
				<li>
					<u>Product Leadership:</u> Served as functional product lead and subject matter expert for the SCC. Translated complex user feedback into technical software requirements and defined the strategic roadmap for platform development.
				</li>
				<li>
					<u>Engineering & QA:</u> Contributed over 1,700 commits to SCC repositories since 2024 (ranked #6 contributor to specify7). Led Quality Assurance and User Experience testing to ensure software reliability and usability. Adopted agile methodologies to improve team efficiency.
				</li>
				<li>
					<u>Cloud Infrastructure:</u> Architected and maintained AWS cloud infrastructure (EC2, RDS, S3, CloudWatch, DynamoDB) ensuring high availability for mission-critical member portals. Implemented cost optimizations reducing annual database server costs by over 60%.
				</li>
				<li>
					<u>Strategic Pricing:</u> Co-led restructuring of Consortium membership levels and pricing tiers to align with operational costs, global market demands, and institutional budgets.
				</li>
				<li>
					<u>Process Improvement:</u> Partnered with the lead software engineer to bridge technical development and user support. Jointly established new internal development processes using staged milestones to align software with community needs.
				</li>
				<li>
					<u>Team Supervision:</u> Recruited, trained, and supervised student support staff. Directed daily workflows to ensure responsive technical assistance for over 500 member collections across 25 countries.
				</li>
			</ul>
			</Card>
			<Card
				heading='Data Integration Specialist'
				subheading='Specify Collections Consortium, University of Kansas'
				date='November 2022 - May 2023'
				imagePath='/src/assets/scc.jpeg'
				altText='Specify Collections Consortium'
				imageClass='h-12 w-auto md:-left-16'
			>
				<ul class='ml-4 list-disc text-muted-foreground'>
					<li>
						<u>Data Migration Engineering:</u> Coordinated large-scale data migration projects for major natural history museums, mapping legacy database structures to modern research data semantics.
					</li>
					<li>
						<u>Interoperability Standards:</u> Designed and implemented automated export pipelines to global biodiversity aggregators (GBIF, iDigBio), ensuring compliance with Darwin Core standards.
					</li>
					<li>
						<u>Technical Communication:</u> Developed comprehensive technical documentation and product requirements to support user adoption and data accessibility, cementing the Specify Community Forum as the #1 source of information and community for the SCC.
					</li>
				</ul>
			</Card>
			<Card
				heading='Student Software Specialist'
				subheading='Specify Collections Consortium, University of Kansas'
				date='October 2021 - November 2022'
				imagePath='/src/assets/scc.jpeg'
				altText='Specify Collections Consortium'
				imageClass='h-12 w-auto md:-left-16'
			>
				<ul class='ml-4 list-disc text-muted-foreground'>
					<li>
						<u>Quality Assurance:</u> Developed workflows for effectively evaluating Specify software during the early stages of development and codified methodologies for staged regression testing at scale.
					</li>
					<li>
						<u>Technical Analysis:</u> Performed complex data cleaning and transformation using SQL and Python to resolve legacy data issues for member institutions.
					</li>
					<li>
						<u>User Interface Design:</u> Collaborated with the engineering team to mock up User Interface (UI) designs and execute regression testing for the Specify 7 platform.
					</li>
					<li>
						<u>Community Support:</u> Provided frontline technical solutions to the research community, fostering trust and ensuring member retention through high-quality service. Created the Specify Community Forum to put a public face on the SCC.
					</li>
				</ul>
			</Card>
			<Card
				heading='Assistant Bakery Manager'
				subheading="Cosentino's Food Stores"
				date='March 2020 - Oct 2021'
				imagePath='/src/assets/cosentinos.png'
				altText='Lorem, ipsum dolor sit'
				imageClass='h-12 w-auto md:-left-16'
			>
				<ul class='ml-4 list-disc text-muted-foreground'>
					<li><u>Team Building & Training:</u> Managed a team, handling scheduling, directing, training, and fostering a positive atmosphere. Facilitated training and onboarding for all new employees, covering baking, cake decorating, closing, and opening procedures.</li>
				</ul>
			</Card>
				</div>
			</details>
		</Section>

		<Section title='Education'>
			<Card
				heading='University of Kansas School of Business'
				subheading='Master of Business Administration'
				date='Present'
				imagePath='/src/assets/jayhawk.png'
				altText='University of Kansas Jayhawk'
				imageClass='h-12 w-auto md:-left-16'
			/>
			<Card
				heading='University of Kansas School of Business'
				subheading='BS, Business Administration; Minor in Information Systems'
				date='May 2023'
				imagePath='/src/assets/jayhawk.png'
				altText='University of Kansas Jayhawk'
				imageClass='h-12 w-auto md:-left-16'
			>
				<ul class='ml-4 list-disc text-muted-foreground'>
					<li>University of Kansas Honor Roll</li>
					<li>Studied cross-cultural management and international business systems in Paderno del Grappa, Italy (<a class="text-blue-500" href="https://www.cimbaitaly.com/">CIMBA</a>).</li>
				</ul>
			</Card>
			<!-- <Card
				heading='Lorem Ipsum'
				subheading='Sit amet consectetur'
				date='Dec 2022 - Nov 2023'
				imagePath='/src/assets/about-astro.png'
				altText='Lorem, ipsum dolor sit'
				imageClass='h-12 w-auto md:-left-16'
			/> -->
		</Section>

		<Section title='Conference Presentations'>
			<div class='space-y-5 text-muted-foreground'>
				<div>
					<h3 class='mb-3 text-sm font-semibold uppercase tracking-wide text-foreground'>Conference talks</h3>
					<div class='grid items-start gap-3 sm:grid-cols-2'>
						<div class='space-y-3'>
							<article class='overflow-hidden rounded-2xl border border-border bg-primary-foreground'>
								<a href='https://spnhc.org/' target='_blank' rel='noreferrer' class='group flex h-24 items-center justify-center border-b border-border px-5' aria-label='Visit SPNHC'>
									<Image src={spnhcLogo} alt='SPNHC' class='h-auto max-h-12 w-full object-contain transition-transform group-hover:scale-[1.03]' />
								</a>
								<div class='p-4'>
									<h4 class='font-semibold text-foreground'>SPNHC</h4>
									<p class='text-xs'>Society for the Preservation of Natural History Collections</p>
									<ul class='mt-3 space-y-3'>
										<li><p class='font-medium text-foreground'>Advancing Biological Collections Computing with Specify 7</p><p class='text-xs'>San Francisco · May 2023</p></li>
										<li><p class='font-medium text-foreground'>Digitization Planning for Large Collections with Specify 7</p><p class='text-xs'>SPNHC–TDWG, Okinawa · September 2024</p></li>
										<li><p class='font-medium text-foreground'>Extending Specify 7 for Geoscience Collections</p><p class='text-xs'>Okinawa · September 2024</p></li>
										<li><p class='font-medium text-foreground'>Publishing Your Data with Specify 7</p><p class='text-xs'>Lawrence · May 2025</p></li>
										<li><p class='font-medium text-foreground'>Specify Spotlight: Improving Data Digitization and Management</p><p class='text-xs'>Lawrence · May 2025</p></li>
										<li><p class='font-medium text-foreground'>Supporting Collaboration with Specify 7</p><p class='text-xs'>Cape Town · September 2026</p></li>
										<li><p class='font-medium text-foreground'>Specify Collections Consortium: Transiting to Sustainability</p><p class='text-xs'>Cape Town · September 2026</p></li>
									</ul>
								</div>
