<script>
	const scrollPairs = [
		{
			wrapper: document.getElementById('blog-scroll-fade') as HTMLDivElement | null,
			scroller: document.querySelector('[data-scroll="blog-posts"]') as HTMLUListElement | null
		},
		{
			wrapper: document.getElementById('projects-scroll-fade') as HTMLDivElement | null,
			scroller: document.querySelector('[data-scroll="projects"]') as HTMLUListElement | null
		}
	]

	function updateFades() {
		scrollPairs.forEach(({ wrapper, scroller }) => {
			if (!wrapper || !scroller) return
			const maxScroll = scroller.scrollWidth - scroller.clientWidth
			const leftVisible = scroller.scrollLeft > 4
			const rightVisible = scroller.scrollLeft < maxScroll - 4
			wrapper.dataset.fadeLeft = leftVisible.toString()
			wrapper.dataset.fadeRight = rightVisible.toString()
		})
	}

	function getScrollAmount(scroller: HTMLElement) {
		const firstItem = scroller.querySelector('li') as HTMLElement | null
		if (!firstItem) return scroller.clientWidth
		const styles = window.getComputedStyle(scroller)
		const gap = Number.parseFloat(styles.columnGap || styles.gap || '0')
		return firstItem.offsetWidth + (Number.isNaN(gap) ? 0 : gap)
	}

	function onChevronClick(event: MouseEvent) {
		const target = event.currentTarget as HTMLElement
		const dir = target.dataset.scrollBtn
		const scrollTarget = target.dataset.scrollTarget
		if (!dir || !scrollTarget) return
		const scroller = document.querySelector(`[data-scroll="${scrollTarget}"]`) as HTMLElement | null
		if (!scroller) return
		const amount = getScrollAmount(scroller)
		scroller.scrollBy({ left: dir === 'next' ? amount : -amount, behavior: 'smooth' })
	}

	updateFades()
	window.addEventListener('resize', updateFades)
	scrollPairs.forEach(({ scroller }) => {
		scroller?.addEventListener('scroll', updateFades, { passive: true })
	})

	document.querySelectorAll<HTMLElement>('[data-scroll-btn]')
		.forEach((btn) => btn.addEventListener('click', onChevronClick))
</script>
